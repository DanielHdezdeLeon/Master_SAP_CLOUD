@EndUserText.label: 'Access control PFCG'
@MappingRole: true
define role ZAC_AIRPORT_4_DHL_ROLE {
    grant select on ZCDS_AIRPORT_4_DHL
                    where ( FlightType ) = 
                    aspect pfcg_auth(ZAO_CAT,ZAUTH_CAT,ACTVT = '03')
//                    and ( CountryCode ) = aspect pfcg_auth( );
//                      and CountryCode = 'ES'
                      ;
                        
}