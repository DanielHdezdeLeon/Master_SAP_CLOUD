@EndUserText.label: 'control de acceso con aspecto personalizado'
@MappingRole: true
define role ZAC_CUSTOM_ASPECT_DHL {
    grant select on ZCDS_AUDITING_ASPECT_DHL
                    where
                        (CustomerName) = aspect ZAC_AUDITING_ASPECT_DHL
                        and InvAmount > 100;
                           
}