annotate entity zcds_customer_meta_DHL with
parameters 
@EndUserText.label: 'Ciudad del cliente'
p_City
{
    @UI.dataFieldDefault: [{ importance: #MEDIUM }]
    @UI.lineItem: [{ position: 10, dataAction: 'Get_Customer' }]
    CustomerId;
     @UI.dataFieldDefault: [{ importance: #MEDIUM }]
    @UI.lineItem: [{ position: 20 }]
    City;
    
}